# ═══════════════════════════════════════════════════════════
# FarmHealth — Git Ignore
# ═══════════════════════════════════════════════════════════

# Dependencies
node_modules/
server/node_modules/
backend/venv/
backend/__pycache__/

# Build outputs
www/
build/
.flutter-plugins-dependencies
.packages

# IDE
.idea/
.vscode/
*.iml

# Environment variables
.env
.env.local
.env.*.local
*.env

# Credentials — never commit service account keys or secrets
credentials/
service-account.json
gcp-key.json
firebase-adminsdk*.json
*-credentials.json

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# Runtime
pids
*.pid
*.seed
*.pid.lock

# Coverage
coverage/
.nyc_output/

# Flutter
.dart_tool/
build/

# Android
android/.gradle/
android/local.properties
android/captures/
android/gradle.properties

# iOS
ios/Pods/
os/.symlinks/
os/Flutter/Flutter.framework/
os/Flutter/Flutter.podspec

# Test
/test/
