# ═══════════════════════════════════════════════════════════
# FarmHealth — Environment Variables
# Copy this file to .env and fill in your values.
# NEVER commit .env to git — it is already in .gitignore
# ═══════════════════════════════════════════════════════════

# ─── Sentinel Hub ───
# https://apps.sentinel-hub.com/dashboard → User Settings → OAuth clients
SENTINEL_HUB_CLIENT_ID=your_client_id_here
SENTINEL_HUB_CLIENT_SECRET=your_client_secret_here

# ─── Google Gemini AI ───
# https://aistudio.google.com/app/apikey (free tier)
GEMINI_API_KEY=your_gemini_api_key_here

# ─── Google Earth Engine (optional — for SAR soil moisture) ───
# Leave blank if you do not need Sentinel-1 SAR data
GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
GOOGLE_CLOUD_PROJECT=your-gcp-project-id

# ─── Ollama (Self-hosted AI — PRIMARY, zero cost) ───
# Install Ollama: https://ollama.ai
# Pull models: ollama pull deepseek-r1:7b && ollama pull llava-phi3
# Run: ollama serve
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=deepseek-r1:7b
OLLAMA_VISION_MODEL=llava-phi3
# Set to 'true' to disable Ollama and use only Gemini/fallback
# OLLAMA_DISABLED=false

# ─── Server ───
PORT=3001
NODE_ENV=development
